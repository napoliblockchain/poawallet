# Configurazione poawallet. Copiare in .env e valorizzare.
# Il file .env NON va in git ne nell'immagine Docker: viene passato al container (env_file).
# Variabili senza "(facoltativa)" sono obbligatorie: se mancano l'app non parte.
# Valori con caratteri speciali: racchiuderli tra apici singoli.

# --- Applicazione ---
APP_WEBSITE=
APP_ADMIN_NAME=
# chiave casuale lunga (es. openssl rand -hex 32)
COOKIE_VALIDATION_KEY=

# --- Database ---
DB_DSN=mysql:host=mysql-main;dbname=napay
DB_USERNAME=
DB_PASSWORD=

# --- Cifratura dati (WebApp::encrypt/decrypt) ---
# ATTENZIONE: devono restare i valori con cui sono cifrati i dati gia nel DB.
ENCRYPT_SECRET_KEY=
ENCRYPT_SECRET_IV=
# (facoltativa, default AES-256-CBC)
ENCRYPT_METHOD=AES-256-CBC

# --- Migrazione dati cifrati nei browser ---
# true: accetta ancora password/PIN/seed salvati nel formato precedente (non legato all'utente)
# e li converte al primo uso. Impostare false quando tutti gli utenti hanno usato il wallet almeno una volta.
CRYPTO_ACCEPT_LEGACY=true

# --- Email ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# ssl -> smtps, altro -> smtp con STARTTLS (facoltativa, default tls)
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME=
MAIL_ADMIN=
MAIL_SUPPORT=
# true in sviluppo: le email vanno su file in runtime/mail (facoltativa, default false)
MAIL_USE_FILE_TRANSPORT=false

# --- Login social (facoltative) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# --- Blockchain (facoltative) ---
SMARTCONTRACT_ADDRESS=
DEFAULT_BLOCKCHAIN=
DEFAULT_SMARTCONTRACT=
# account che invia gas agli utenti (zerogas faucet). Vuoto = faucet disattivato.
# Usare un account dedicato con fondi limitati, non le chiavi dei sealer.
SEALER_ACCOUNT_3=
SEALER_PRVKEY_3=
SEALER_ACCOUNT_2=
SEALER_PRVKEY_2=

# --- Notifiche push web (facoltative: vuote = push disattivate) ---
# generare una coppia nuova: Minishlink\WebPush\VAPID::createVapidKeys() (vendor/minishlink/web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contatto per i servizi push: mailto: o URL https (facoltativa, default mailto:MAIL_SUPPORT)
VAPID_SUBJECT=

# --- Realtime verso ws-notify (facoltative: REDIS_HOST vuoto = realtime disattivato) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
# stesso valore di NOTIFY_CHANNEL del servizio ws-notify
NOTIFY_CHANNEL=poawallet:notify

# --- WebSocket notifiche (facoltative, default /ws-notify) ---
WEBSOCKET_URL=/ws-notify
WEBSOCKET_URL_LOCALHOST=/ws-notify
